# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Baseline libraries are downloaded/built by scripts/setup_third_party.sh (MKL may not be redistributed)
third_party/
# Generated by scripts/gen_codelets.py during the build
csrc/dft/codelets_gen.h
# Superseded first run (taken while other applications were running)
results/run1_noisy/
# Scratch outputs of quick runs / smoke tests
results/quick.csv
results/machines/*-quick/
results/machines/smoketest*/
# Run logs (stage output of run_machine.sh, run_all.sh and the study scripts) are not kept
*.log
results/**/logs/
